{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "description": "Infinity datasource pointing at rustikv-telemetry-gateway",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "1.0.0" }
  ],
  "title": "rustikv Telemetry \u2014 Raspberry Pi",
  "uid": "rustikv-pi",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "textbox",
        "label": "Pi hostname",
        "description": "collectd hostname (check /etc/collectd/collectd.conf Hostname setting)",
        "current": { "value": "cyber", "text": "cyber", "selected": true },
        "options": [{ "value": "cyber", "text": "cyber", "selected": true }],
        "hide": 0
      },
      {
        "name": "step",
        "type": "textbox",
        "label": "Aggregation step (s)",
        "description": "Bucket size in seconds passed to rustikv aggregation ops",
        "current": { "value": "60", "text": "60", "selected": true },
        "options": [{ "value": "60", "text": "60", "selected": true }],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage %",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "user",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "user",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.cpu.percent-user&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "system",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "system",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.cpu.percent-system&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "wait",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "iowait",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.cpu.percent-wait&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "used",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "used",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.memory.memory-used&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "cached",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "cached",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.memory.memory-cached&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "buffered",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "buffered",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.memory.memory-buffered&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load Average",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "load1",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "1m",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.load.load.shortterm&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "load5",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "5m",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.load.load.midterm&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "load15",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "15m",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.load.load.longterm&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SoC Temperature",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null,  "color": "green" },
              { "value": 60,    "color": "yellow" },
              { "value": 75,    "color": "red" }
            ]
          },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        {
          "refId": "temp",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "temperature",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.thermal-thermal_zone0.temperature&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk Space (root)",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "dfused",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "used",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.df-root.df_complex-used&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "dffree",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "free",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.df-root.df_complex-free&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network I/O (eth0)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "netrx",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "rx",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.interface-eth0.if_octets.rx&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "nettx",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "tx",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.interface-eth0.if_octets.tx&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disk I/O (mmcblk0)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "diskread",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "read",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.disk-mmcblk0.disk_octets.read&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        },
        {
          "refId": "diskwrite",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "seriesName": "write",
          "url": "http://GATEWAY_IP:8080/query?metric=pi.${host}.disk-mmcblk0.disk_octets.write&from=${__from:date:seconds}&to=${__to:date:seconds}&agg=avg&step=${step}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "time",  "text": "time",  "type": "timestamp_epoch_ms" },
            { "selector": "value", "text": "value", "type": "number" }
          ]
        }
      ]
    }
  ]
}
